{
  "sandbox": {
    "credentials": {
      "envVars": {
        "COPILOT_GITHUB_TOKEN": {
          "injectHosts": [
            "api.github.com",
            "api.githubcopilot.com"
          ]
        }
      }
    },
    "enabled": true,
    "userPolicy": {
      "network": {
        "allowedHosts": [
          "api.github.com",
          "api.githubcopilot.com",
          "github.com"
        ],
        "blockedHosts": [
          "uploads.github.com"
        ]
      }
    }
  }
}
